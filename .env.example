# ---------------------------------------------------------------------------
# Routely client - environment template
# Copy to `.env.local` and fill in real values. Never commit the real file.
# ---------------------------------------------------------------------------

# Base URL of this Next.js app. Better Auth uses it as the trusted origin, so
# it must match the address the browser actually uses, including the port.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the Express API. Exposed to the browser, so it must be
# reachable from the client - not "localhost" on a remote deployment.
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- Better Auth ----------------------------------------------------------
# Keep these two identical to NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Atlas connection string for the auth tables (user, session,
# account, verification). The API uses a separate MONGODB_URI in its own
# .env, but both must point at the same database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Optional Google sign-in. Leave blank to disable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
